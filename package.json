{
  "name": "playwright-ts-quality-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript and Playwright portfolio framework with a local order-management test fixture.",
  "engines": { "node": ">=22.13.0 <23" },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start:api": "node dist/api/server.js",
    "preview:web": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tests.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc -p tsconfig.api.json && vite build",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:isolation": "playwright test --project=api tests/api/namespace-isolation.spec.ts",
    "test:regression": "tsx --test tests/regression/*.test.ts",
    "report": "playwright show-report"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
